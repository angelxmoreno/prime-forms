{
    "name": "cakephp/app",
    "description": "CakePHP skeleton app",
    "license": "MIT",
    "type": "project",
    "homepage": "https://cakephp.org",
    "require": {
        "php": ">=8.4",
        "cakephp/cakephp": "^5.3.0",
        "cakephp/migrations": "^4.0.0",
        "cakephp/plugin-installer": "^2.0",
        "mobiledetect/mobiledetectlib": "^4.8.03"
    },
    "require-dev": {
        "cakephp/bake": "^3.0.0",
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/debug_kit": "^5.2.0",
        "captainhook/captainhook": "^5.29",
        "ergebnis/composer-normalize": "^2.50",
        "josegonzalez/dotenv": "^4.0",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3",
        "ramsey/conventional-commits": "^1.7",
        "systemsdk/phpcpd": "^8.3"
    },
    "suggest": {
        "cakephp/repl": "Console tools for a REPL interface for CakePHP applications.",
        "dereuromark/cakephp-ide-helper": "After baking your code, this keeps your annotations in sync with the code evolving from there on for maximum IDE and PHPStan/Psalm compatibility.",
        "markstory/asset_compress": "An asset compression plugin which provides file concatenation and a flexible filter system for preprocessing and minification.",
        "phpstan/phpstan": "PHPStan focuses on finding errors in your code without actually running it. It catches whole classes of bugs even before you write tests for the code."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true
        },
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "App\\Console\\Installer::postInstall",
            "@captainhook-install"
        ],
        "post-update-cmd": [
            "@captainhook-install"
        ],
        "post-create-project-cmd": [
            "App\\Console\\Installer::postInstall",
            "@captainhook-install"
        ],
        "captainhook-install": "vendor/bin/captainhook install --force --only-enabled",
        "check": [
            "@test",
            "@cs-check",
            "@dup-check"
        ],
        "composer-normalize": "composer normalize",
        "composer-normalize-check": "composer normalize --dry-run",
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "dup-check": "phpcpd --fuzzy src tests",
        "test": "phpunit --colors=always"
    }
}
